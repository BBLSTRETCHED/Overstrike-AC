<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>ArkhamCity\OverstrikeAC.ico</ApplicationIcon>

    <Authors>Tkachov</Authors>
    <Title>Overstrike AC</Title>
    <Product>Overstrike AC</Product>
    <Description>Overstrike AC — experimental Arkham City mod manager fork</Description>

    <AssemblyVersion>1.8.1.0</AssemblyVersion>

    <FileVersion>1.8.1.0</FileVersion>

    <Platforms>x64</Platforms>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <RepositoryUrl>https://github.com/Tkachov/Overstrike/</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="ArkhamCity\OverstrikeAC.ico" />
    <Content Include="ArkhamCity\logo.png" CopyToOutputDirectory="PreserveNewest" TargetPath="Support\logo.png" />
    <Content Include="Properties\Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="7.0.0" />
    <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAT1\DAT1.csproj" />
    <ProjectReference Include="..\OverstrikeShared\OverstrikeShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Cross-build only: patch the UNBUNDLED host before .NET calculates bundle offsets. -->
  <Target Name="EmbedCityIconBeforeBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle" Condition="'$(PatchCityIcon)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../tools/embed_windows_icon.py&quot; &quot;$(AppHostIntermediatePath)&quot; &quot;$(MSBuildProjectDirectory)/ArkhamCity/OverstrikeAC.ico&quot;" />
  </Target>
</Project>
